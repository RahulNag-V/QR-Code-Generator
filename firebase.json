{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.py",
      "package*.json",
      "tsconfig.json"
    ],
    "rewrites": [
      {
        "source": "!/about**",
        "destination": "/index.html"
      }
    ]
  }
}
